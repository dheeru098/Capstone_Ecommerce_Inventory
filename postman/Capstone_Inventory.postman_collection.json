    {
      "name": "05 - Token Rotation",
      "item": [
        {
          "name": "Rotate Customer Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/refresh",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{customerRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const oldToken = pm.environment.get(\"customerRefreshToken\");",
                  "  const body = pm.response.json();",
                  "  pm.environment.set(\"oldCustomerRefreshToken\", oldToken);",
                  "  pm.environment.set(\"customerToken\", body.data.accessToken);",
                  "  pm.environment.set(\"customerRefreshToken\", body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Old Refresh Token Reuse 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
